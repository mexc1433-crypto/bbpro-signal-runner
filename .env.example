# ═══════════════════════════════════════════════════════════════
# BBPro Signal Bot — Ultimate v3 Environment Variables
# ═══════════════════════════════════════════════════════════════

# === cTrader Open API (required — for market data) ===
CTRADER_CLIENT_ID_3=your_client_id_here
CTRADER_SECRET_4=your_secret_here
CTRADER_ACCESS_TOKEN_2=your_access_token_here
CTRADER_ACCOUNT_ID=your_account_id_here

# === Telegram (required — for sending signals) ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# === Groq AI (optional — for AI confidence scoring) ===
GROQ_API_KEY=your_groq_key

# === Server ===
PORT=8080
PYTHONUNBUFFERED=1

# === Signal-only mode (true = no real trades, just recommendations) ===
SIGNAL_ONLY_MODE=true

# === AI confidence threshold (0-100) ===
AI_MIN_CONFIDENCE=60

# === Database ===
DB_ENABLED=true
DB_PATH=/tmp/bbpro_trades.db

# ═══════════════════════════════════════════════════════════════
# SIGNAL SETTINGS
# ═══════════════════════════════════════════════════════════════

# Cooldown between signals for same symbol (minutes)
COOLDOWN_MINUTES=120

# Minimum Risk:Reward ratio
MIN_RR_RATIO=1.5

# Signal expiry in bars (48 bars = ~24h on M30)
SIGNAL_EXPIRY_BARS=48

# ═══════════════════════════════════════════════════════════════
# STRATEGY SETTINGS
# ═══════════════════════════════════════════════════════════════

# Require consensus from multiple strategies
REQUIRE_CONSENSUS=false
MIN_CONSENSUS=2

# Multi-timeframe confluence
ENABLE_MTF=true
MIN_TF_CONFLUENCE=50

# Candlestick patterns
ENABLE_CANDLESTICK=true

# Economic calendar (block signals during high-impact news)
ENABLE_ECON_CAL=true

# Pre-signal alerts (notify when price approaches BB band)
ENABLE_PRE_SIGNAL=true

# Daily performance reports
ENABLE_DAILY_REPORT=true

# Support/Resistance levels in signal
ENABLE_SR_LEVELS=true

# Inline Telegram buttons (✅/❌/⏰)
ENABLE_INLINE_BUTTONS=true

# ═══════════════════════════════════════════════════════════════
# ADVANCED (v3) — All enabled by default
# ═══════════════════════════════════════════════════════════════
# Smart Money Concepts: Order Blocks, FVG, BOS/CHoCH, Liquidity
# VWAP: Volume Weighted Average Price
# Market Regime: trending/ranging/volatile/choppy detection
# Divergence: RSI & MACD divergence
# Risk Manager Pro: Kelly Criterion, Multi-TP, Signal Quality Score
# Backtest: Run /backtest command on Telegram
# All v3 features are auto-enabled if modules are present
