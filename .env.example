# BBPro Signal Bot - Environment Variables
# انسخ هذا الملف إلى .env واملأ القيم

# Telegram Bot
BOT_TOKEN=ضع_توكن_البوت_هنا
PUBLIC_CHANNEL_ID=-100xxxxxxxxxx
PRIVATE_CHANNEL_ID=-100xxxxxxxxxx
ADMIN_ID=123456789

# Exchange (MEXC or Binance)
EXCHANGE=mexc
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Logging
LOG_LEVEL=INFO
TIMEZONE=Africa/Cairo
